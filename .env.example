# Firebase Authentication, Firestore en Storage.
# Kopieer dit bestand naar .env.local en vul de waarden in uit de Firebase-console
# (Projectinstellingen > Je apps > Web-app). Dit zijn publieke waarden, geen geheimen;
# de bescherming zit in firestore.rules en storage.rules. Zie docs/en/setup.md (Nederlands: docs/nl/INSTALLEREN.md).
#
# Laat je alles leeg, dan draait de app in demomodus: alles blijft in de browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optioneel: een benoemde Firestore-databank. Leeg = de standaarddatabank (aanbevolen:
# storage.rules leest de toegang uit de standaarddatabank).
NEXT_PUBLIC_FIRESTORE_DATABASE=

# Bucket voor foto's en audio bij quizvragen. Leeg = uploaden werkt alleen in deze browser.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Standaardtaal zolang een beheerder niets bewaarde: nl, en, fr of es. Leeg = nl.
NEXT_PUBLIC_DEFAULT_LANGUAGE=

# Optioneel, voor inlezen en audio naar tekst (Whisper). Gewoonlijk vul je de sleutel van
# OpenAI in via Beheer > Spraak. Dit is een GEHEIM: nooit met NEXT_PUBLIC_ ervoor.
#   OPENAI_API_KEY: sleutel van OpenAI, als je hem niet in het beheer wil zetten.
#   FIREBASE_SERVICE_ACCOUNT: de JSON van een serviceaccount, zodat de server de sleutel uit
#     het beheer kan lezen. Niet nodig op Firebase App Hosting.
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Alleen voor lokaal testen: laat Firestore tegen de emulator praten (firebase emulators:start).
NEXT_PUBLIC_FIRESTORE_EMULATOR=
